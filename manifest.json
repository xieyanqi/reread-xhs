{
  "manifest_version": 3,
  "name": "拾读 · 小红书收藏复读",
  "short_name": "拾读",
  "description": "把小红书收藏转成自己的笔记和行动，到期复盘。",
  "version": "0.1.5",
  "minimum_chrome_version": "116",
  "permissions": ["scripting", "sidePanel", "storage", "alarms", "notifications"],
  "host_permissions": ["https://xiaohongshu.com/*", "https://www.xiaohongshu.com/*", "https://m.xiaohongshu.com/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_title": "打开拾读"},
  "side_panel": {"default_path": "index.html"},
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
}
